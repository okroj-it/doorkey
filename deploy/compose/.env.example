# --- required ---------------------------------------------------------------

# The public https origin your tags point at. Passkeys are bound to its host.
DOORKEY_ORIGIN=https://door.example.com

# Home Assistant: a URL reachable from inside the container, and a long-lived
# token (Profile → Security → Long-lived access tokens). Use an IP or a DNS
# name: mDNS names like homeassistant.local usually do not resolve inside
# containers. HA on the same machine: http://host.docker.internal:8123
HA_URL=http://192.168.1.10:8123
HA_TOKEN=
HA_LOCK_ENTITY=lock.front_door

# openssl rand -hex 32, each. Losing the pepper invalidates every guest code.
DOORKEY_PEPPER=
DOORKEY_SESSION_SECRET=

# Bundled Postgres. Or set DATABASE_URL to your own server and drop `db`.
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://doorkey:secret@postgres.lan:5432/doorkey

# --- tags -------------------------------------------------------------------

# sun: NTAG 424 DNA (recommended). static: any NTAG213 with a fixed secret path.
DOORKEY_TAP_MODE=sun
# sun: openssl rand -hex 32 for the KEK; K2 from your provisioning setup.
DOORKEY_TAG_KEK=
DOORKEY_TAG_META_KEY=
# static: openssl rand -hex 16
# DOORKEY_STATIC_PATH=

# --- optional ---------------------------------------------------------------

TZ=Europe/Berlin
# notify.<service> for push on entries and action runs, e.g. mobile_app_pixel
HA_NOTIFY_SERVICE=
# MQTT discovery for the keypad state entities
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# Client IPs that count as home for home-only actions
DOORKEY_HOME_CIDRS=
